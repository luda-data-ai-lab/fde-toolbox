DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/fde.db
# PostgreSQL: postgresql+psycopg://fde:fde@localhost:5432/fde
# SQL Server: mssql+pyodbc://user:pass@localhost:1433/fde?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATA_DIR=./data
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key
DEPLOYMENT_MODE=standalone
ADAPTERS_ALLOWED=false
MAX_UPLOAD_MB=20
DEFAULT_LOCALE=ko
DEPLOYMENT_BASE_IRI=https://ludaresearch.org/onto/
COOKIE_SECURE=false
ONTO_SIMILARITY_THRESHOLD=80
